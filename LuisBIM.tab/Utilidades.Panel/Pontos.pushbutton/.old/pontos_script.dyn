    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# -*- coding: utf-8 -*-\r\n\r\nimport clr\r\nimport System # Necessário para System.Enum e System.Math\r\n\r\n# --- Importações do Revit e Dynamo ---\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n# --- Importações Essenciais para WPF ---\r\nclr.AddReference('PresentationFramework')\r\nclr.AddReference('PresentationCore')\r\nclr.AddReference('WindowsBase')\r\nclr.AddReference('System.Xml')\r\n\r\nfrom System.IO import StringReader\r\nfrom System.Xml import XmlReader\r\nfrom System.Windows.Markup import XamlReader\r\nfrom System.Windows import (Window, Thickness, VerticalAlignment, HorizontalAlignment, \r\n                            FontWeights, SizeToContent, TextAlignment) \r\n# --- CORREÇÃO 1: Importar TextBox ---\r\nfrom System.Windows.Controls import (TextBlock, Label, Grid, StackPanel, \r\n                                     GroupBox, Button, TextBox) \r\nfrom System.Windows.Media import Brushes, BrushConverter\r\nfrom System.Globalization import CultureInfo, NumberStyles\r\n\r\n# --- Constantes e Helpers ---\r\nFEET_TO_METERS = 0.3048\r\nPI = System.Math.PI\r\n\r\ndef format_coord_to_br(value_in_feet):\r\n    \"\"\"Converte de pés para metros e formata para o padrão brasileiro (3 casas, vírgula).\"\"\"\r\n    meters = value_in_feet * FEET_TO_METERS\r\n    return meters.ToString(\"N3\", CultureInfo(\"pt-BR\"))\r\n\r\ndef get_param_value_as_formatted_string(element, param_name, is_angle=False):\r\n    \"\"\"Busca o valor numérico, converte (se necessário) e formata com precisão.\"\"\"\r\n    try:\r\n        param = element.LookupParameter(param_name)\r\n        if not param:\r\n            return \"Não encontrado\"\r\n        if is_angle:\r\n            degrees = param.AsDouble() * (180.0 / PI) \r\n            return degrees.ToString(\"N2\", CultureInfo(\"pt-BR\")) + u\"°\" \r\n        value_in_feet = param.AsDouble() \r\n        return format_coord_to_br(value_in_feet) \r\n    except Exception as e:\r\n        return \"Erro: \" + str(e)\r\n\r\n# --- CORREÇÃO 2: Função 'create_cell' modificada ---\r\ndef create_cell(content, row, col, is_header=False, align='Center'):\r\n    \"\"\"Cria um TextBox (selecionável) para ser inserido na Grid WPF.\"\"\"\r\n    \r\n    # 1. Criar um TextBox\r\n    text_box = TextBox()\r\n    text_box.Text = unicode(content)\r\n    \r\n    # 2. Definir alinhamento do texto\r\n    text_box.TextAlignment = System.Enum.Parse(TextAlignment, align)\r\n    \r\n    # 3. Alinhar o conteúdo verticalmente (diferente de TextBlock)\r\n    text_box.VerticalContentAlignment = VerticalAlignment.Center\r\n    \r\n    # 4. Definir espaçamento interno (padding) em vez de externo (margin)\r\n    text_box.Padding = Thickness(5)\r\n    \r\n    # 5. --- A MÁGICA PARA PARECER UM RÓTULO ---\r\n    text_box.IsReadOnly = True      # Não deixa editar\r\n    text_box.BorderThickness = Thickness(0) # Remove a borda\r\n    \r\n    # 6. Definir estilos (como antes)\r\n    if is_header:\r\n        text_box.FontWeight = FontWeights.Bold\r\n        text_box.Background = BrushConverter().ConvertFromString(\"#EEE\")\r\n    else:\r\n        text_box.Background = Brushes.White # Fundo branco padrão da célula\r\n        \r\n    # 7. Adicionar à Grid\r\n    Grid.SetRow(text_box, row)\r\n    Grid.SetColumn(text_box, col)\r\n    return text_box\r\n\r\n# --- Obter Entradas do Dynamo ---\r\ntry:\r\n    wrapped_sp = IN[0]\r\n    wrapped_pbp = IN[1]\r\n    \r\n    doc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n    if not wrapped_sp or not wrapped_pbp:\r\n        raise System.Exception(\"Uma ou ambas as entradas (IN[0], IN[1]) estão vazias (None).\")\r\n    \r\n    sp_element = doc.GetElement(ElementId(wrapped_sp.Id))\r\n    pbp_element = doc.GetElement(ElementId(wrapped_pbp.Id))\r\n    \r\n    if not sp_element or not pbp_element:\r\n        raise System.Exception(\"Falha ao 'desembrulhar' (unwrap) os elementos.\")\r\n\r\n    # --- 1. Extrair Dados: Ponto de Vistoria (SP) ---\r\n    sp_bbox = sp_element.get_BoundingBox(None)\r\n    \r\n    if not sp_bbox:\r\n         raise System.Exception(\"Não foi possível obter a geometria do Ponto de Vistoria (SP).\")\r\n         \r\n    sp_center = (sp_bbox.Min + sp_bbox.Max) / 2.0\r\n    sp_x = format_coord_to_br(sp_center.X)\r\n    sp_y = format_coord_to_br(sp_center.Y)\r\n    sp_z = format_coord_to_br(sp_center.Z)\r\n    \r\n    sp_ns = get_param_value_as_formatted_string(sp_element, \"N/S\")\r\n    sp_lo = get_param_value_as_formatted_string(sp_element, \"L/O\")\r\n    sp_elev = get_param_value_as_formatted_string(sp_element, \"Elev\")\r\n    sp_angle = \"Não se aplica\" \r\n\r\n    # --- 2. Extrair Dados: Ponto Base do Projeto (PBP) ---\r\n    pbp_bbox = pbp_element.get_BoundingBox(None)\r\n    \r\n    if not pbp_bbox:\r\n         raise System.Exception(\"Não foi possível obter a geometria do Ponto Base do Projeto (PBP).\")\r\n         \r\n    pbp_center = (pbp_bbox.Min + pbp_bbox.Max) / 2.0\r\n    pbp_x = format_coord_to_br(pbp_center.X)\r\n    pbp_y = format_coord_to_br(pbp_center.Y)\r\n    pbp_z = format_coord_to_br(pbp_center.Z)\r\n    \r\n    pbp_ns = get_param_value_as_formatted_string(pbp_element, \"N/S\")\r\n    pbp_lo = get_param_value_as_formatted_string(pbp_element, \"L/O\")\r\n    pbp_elev = get_param_value_as_formatted_string(pbp_element, \"Elev\")\r\n    pbp_angle = get_param_value_as_formatted_string(pbp_element, \"Ângulo para norte verdadeiro\", is_angle=True)\r\n\r\nexcept Exception as e:\r\n    OUT = \"Erro ao ler dados dos elementos. Detalhe: \" + str(e)\r\n    raise System.Exception(\"Erro nos inputs: \" + str(e))\r\n\r\n\r\n# --- Definição da Interface (XAML) ---\r\n# (O XAML permanece o mesmo)\r\nxaml_string = \"\"\"\r\n<Window xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\r\n        xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\r\n        Title=\"Coordenadas dos Pontos Base\" \r\n        Width=\"1100\" \r\n        SizeToContent=\"WidthAndHeight\" \r\n        WindowStartupLocation=\"CenterScreen\" \r\n        Topmost=\"True\" \r\n        ResizeMode=\"CanResizeWithGrip\">\r\n    \r\n    <StackPanel Margin=\"15\">\r\n        \r\n        <Grid x:Name=\"dataGrid\" ShowGridLines=\"True\" Margin=\"0,0,0,10\">\r\n            <Grid.ColumnDefinitions>\r\n                <ColumnDefinition Width=\"Auto\" MinWidth=\"260\" /> <ColumnDefinition Width=\"Auto\" MinWidth=\"80\" />  <ColumnDefinition Width=\"Auto\" MinWidth=\"80\" />  <ColumnDefinition Width=\"Auto\" MinWidth=\"80\" />  <ColumnDefinition Width=\"Auto\" MinWidth=\"110\" /> <ColumnDefinition Width=\"Auto\" MinWidth=\"110\" /> <ColumnDefinition Width=\"Auto\" MinWidth=\"110\" /> <ColumnDefinition Width=\"*\" MinWidth=\"150\" />  </Grid.ColumnDefinitions>\r\n            <Grid.RowDefinitions>\r\n                <RowDefinition Height=\"Auto\" /> <RowDefinition Height=\"Auto\" /> <RowDefinition Height=\"Auto\" /> </Grid.RowDefinitions>\r\n        </Grid>\r\n        \r\n        <Button x:Name=\"btnClose\" Content=\"Fechar\" Width=\"100\" HorizontalAlignment=\"Right\" Margin=\"0,10,0,0\" IsDefault=\"True\" />\r\n        \r\n    </StackPanel>\r\n</Window>\r\n\"\"\"\r\n\r\n# --- Lógica da Janela ---\r\n# (Esta seção permanece a mesma)\r\noutput = \"Janela não inicializada.\"\r\n\r\ntry:\r\n    reader = StringReader(xaml_string)\r\n    xml_reader = XmlReader.Create(reader)\r\n    window = XamlReader.Load(xml_reader)\r\n    \r\n    grid = window.FindName(\"dataGrid\")\r\n    \r\n    # --- Linha 0: Headers ---\r\n    grid.Children.Add(create_cell(\"PONTO\", 0, 0, True))\r\n    grid.Children.Add(create_cell(\"X(metros)\", 0, 1, True))\r\n    grid.Children.Add(create_cell(\"Y(metros)\", 0, 2, True))\r\n    grid.Children.Add(create_cell(\"Z(metros)\", 0, 3, True))\r\n    grid.Children.Add(create_cell(\"N/S(metros)\", 0, 4, True))\r\n    grid.Children.Add(create_cell(\"L/O(metros)\", 0, 5, True))\r\n    grid.Children.Add(create_cell(\"ELEV. (metros)\", 0, 6, True))\r\n    grid.Children.Add(create_cell(\"ÂNGULO PARA N. VERDADEIRO (graus)\", 0, 7, True))\r\n    \r\n    # --- Linha 1: Ponto de Vistoria (SP) ---\r\n    grid.Children.Add(create_cell(u\"▲ PONTO DE LEVANTAMENTO TOPOGRÁFICO\", 1, 0, align='Left'))\r\n    grid.Children.Add(create_cell(sp_x, 1, 1, align='Right'))\r\n    grid.Children.Add(create_cell(sp_y, 1, 2, align='Right'))\r\n    grid.Children.Add(create_cell(sp_z, 1, 3, align='Right'))\r\n    grid.Children.Add(create_cell(sp_ns, 1, 4, align='Right'))\r\n    grid.Children.Add(create_cell(sp_lo, 1, 5, align='Right'))\r\n    grid.Children.Add(create_cell(sp_elev, 1, 6, align='Right'))\r\n    grid.Children.Add(create_cell(sp_angle, 1, 7, align='Center'))\r\n    \r\n    # --- Linha 2: Ponto Base do Projeto (PBP) ---\r\n    grid.Children.Add(create_cell(u\"⌖ POTO BASE DO PROJETO\", 2, 0, align='Left'))\r\n    grid.Children.Add(create_cell(pbp_x, 2, 1, align='Right'))\r\n    grid.Children.Add(create_cell(pbp_y, 2, 2, align='Right'))\r\n    grid.Children.Add(create_cell(pbp_z, 2, 3, align='Right'))\r\n    grid.Children.Add(create_cell(pbp_ns, 2, 4, align='Right'))\r\n    grid.Children.Add(create_cell(pbp_lo, 2, 5, align='Right'))\r\n    grid.Children.Add(create_cell(pbp_elev, 2, 6, align='Right'))\r\n    grid.Children.Add(create_cell(pbp_angle, 2, 7, align='Right'))\r\n\r\n    def close_window(sender, e):\r\n        window.Close()\r\n\r\n    close_button = window.FindName(\"btnClose\")\r\n    close_button.Click += close_window\r\n    \r\n    window.ShowDialog()\r\n    \r\n    output = \"Janela exibida e fechada pelo usuário.\"\r\n\r\nexcept Exception as e:\r\n    output = \"Erro ao criar janela WPF: \" + str(e)\r\n\r\nOUT = output",
      "Engine": "IronPython2",
