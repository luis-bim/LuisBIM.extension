  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# -*- coding: utf-8 -*-\r\n\r\n# Importar bibliotecas comuns (Common Language Runtime)\r\nimport clr\r\n\r\n# Importar APIs do Revit\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.UI import *\r\n\r\n# Importar bibliotecas do .NET para criar listas de IDs\r\nimport System\r\nfrom System.Collections.Generic import List\r\n\r\n# Importar serviços do Revit (para acesso ao Documento no Dynamo)\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n# Obter o documento e a interface de usuário (UI) do documento atual\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\n\r\n# Inicializar a variável que armazenará o Ponto Base\r\nproject_base_point = None\r\n\r\n# --- Lógica Principal ---\r\n\r\n# 1. Criar um coletor de elementos no documento\r\ncollector = FilteredElementCollector(doc)\r\n\r\n# 2. Filtrar o coletor para encontrar apenas elementos da classe 'BasePoint'\r\n#    Isso inclui tanto o Ponto Base do Projeto quanto o Ponto de Vistoria (Survey Point)\r\nall_base_points = collector.OfClass(BasePoint).ToElements()\r\n\r\n# 3. Iterar pelos BasePoints encontrados\r\nfor bp in all_base_points:\r\n    # O Ponto Base do Projeto (PBP) é o 'BasePoint' cuja propriedade 'IsShared' é False.\r\n    # O Ponto de Vistoria (Survey Point) teria 'IsShared' == True.\r\n    if not bp.IsShared:\r\n        project_base_point = bp\r\n        break # Encontramos o que queríamos, podemos parar o loop\r\n\r\n# --- Saída e Seleção ---\r\n\r\nif project_base_point:\r\n    # 4. Se encontramos o PBP, vamos selecioná-lo na UI\r\n    \r\n    # Criar uma lista .NET de ElementIds\r\n    ids_to_select = List[ElementId]()\r\n    ids_to_select.Add(project_base_point.Id)\r\n    \r\n    # Definir a seleção atual no Revit para destacar o PBP\r\n    # Isso é o mesmo que clicar no elemento\r\n    uidoc.Selection.SetElementIds(ids_to_select)\r\n    \r\n    # 5. Enviar o elemento para a porta de saída (OUT) do nó Python\r\n    OUT = project_base_point\r\nelse:\r\n    # Se, por algum motivo, não for encontrado\r\n    OUT = None",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": true,
      "Id": "68f8c5408a9f4b819d5a3e7b0ad911e8",
      "Inputs": [
