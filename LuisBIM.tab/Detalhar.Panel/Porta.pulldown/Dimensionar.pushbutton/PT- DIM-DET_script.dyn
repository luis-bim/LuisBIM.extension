      "Code": "# referencias .NET e Dynamo/Revit\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nclr.AddReference('RevitNodes')\r\n\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nfrom Autodesk.Revit.DB import View\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n# ----------------------------------------------------------------\r\n# — ENTRADAS —\r\n# IN[0] = elemento de vista (Dynamo View) que queremos ativar\r\n# ----------------------------------------------------------------\r\n\r\n# obtém o UIDocument atual\r\nuidoc = DocumentManager.Instance.CurrentUIDocument\r\n\r\n# converte de Dynamo (Revit.Elements.View) para Autodesk.Revit.DB.View\r\nview_to_activate = UnwrapElement(IN[0])\r\n\r\n# solicita ao Revit que troque a vista ativa\r\n# (não é necessário iniciar transação, pois não altera nada no modelo)\r\nuidoc.RequestViewChange(view_to_activate)\r\n\r\n# opcional: saída para verificar no Dynamo\r\nOUT = view_to_activate\r\n",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": true,
      "Id": "9141dc31a58744698a651d4b893d0e68",
      "Inputs": [
        {
          "Id": "dff58822046e4442ae46fcb2b66e88c3",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "38516296a8274d658afc7912f45d9f9a",
          "Name": "OUT",
          "Description": "Resultado do script Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Executa um script Python incorporado."
    }
