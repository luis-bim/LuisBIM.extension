    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference(\"System.Windows.Forms\")\r\nfrom System.Windows.Forms import MessageBox, MessageBoxButtons, MessageBoxIcon\r\n\r\n# Obtenha a mensagem de entrada\r\ninput_data = IN[0]\r\n\r\n# Converta para string, caso necessário\r\nif isinstance(input_data, list):\r\n    message = \"\\n\".join(map(str, input_data))\r\nelse:\r\n    message = str(input_data)\r\n\r\n# Exiba o pop-up com a mensagem\r\nMessageBox.Show(message, \"Mensagem\", MessageBoxButtons.OK, MessageBoxIcon.Information)\r\n\r\n# Saída do script\r\nOUT = \"Mensagem exibida com sucesso!\"\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
